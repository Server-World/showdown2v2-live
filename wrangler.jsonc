{
  "name": "showdown2v2-live",
  "compatibility_date": "2026-08-16",
  "main": "worker/index.mjs",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "showdown2v2.live",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/command-center",
      "/command-center/*",
      "/command-center.css",
      "/command-center.js",
      "/command-center-activity.js"
    ]
  }
}
