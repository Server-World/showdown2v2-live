{
  "name": "ssl-site-health",
  "main": "src/index.js",
  "compatibility_date": "2026-08-13",
  "workers_dev": true,
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "SITE_ORIGIN": "https://showdown2v2.live"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
